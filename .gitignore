# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyo
*.pyd

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# ─── Database / Telemetry (never commit live data) ────────────────────────────
*.db
*.sqlite
*.sqlite3
ledger_telemetry.db

# ─── Node.js / Frontend ───────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm

# ─── Environment / Secrets ────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Keep the example file — it has no real secrets
!.env.example

# ─── OS / Editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.iml

# ─── Uploads / Temp files ─────────────────────────────────────────────────────
uploads/
tmp/
temp/
*.tmp

# ─── Task / Notes (personal, not for repo) ────────────────────────────────────
task.txt

# ─── Jupyter checkpoints ──────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# Playwright MCP screenshot artifacts
.playwright-mcp/
**/.playwright-mcp/

# Vercel's project link. It lives at the repo root now that the project's
# Root Directory is frontend/ and the CLI has to be run from here, so the
# frontend/.gitignore entry no longer covers it.
.vercel
